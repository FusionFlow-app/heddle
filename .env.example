# Everything here is optional: `docker compose up` works without this file.

# Generated on first boot and kept in the heddle_data volume when left empty.
SECRET_KEY_BASE=

# Public domain, only when Heddle sits behind HTTPS. Turns on the HTTPS redirect.
PHX_HOST=

# Port published on this machine.
HEDDLE_PORT=4000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
