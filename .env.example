# Everything here is optional: `docker compose up` works without this file.

# Generated on first boot and kept in the heddle_data volume when left empty.
SECRET_KEY_BASE=

# Public domain, only when Heddle sits behind HTTPS. Turns on the HTTPS redirect.
PHX_HOST=

# Port published on this machine.
HEDDLE_PORT=4000

# LLM used by the flow chats. Any provider supported by req_llm.
HEDDLE_LLM_PROVIDER=
HEDDLE_LLM_MODEL=
HEDDLE_LLM_API_KEY=

# Claude Agent, the copilot of the editor chat. Turned on in LLM & Agents.
# Needs the claude binary on this server: see INSTALL_CLAUDE in the Dockerfile.
# The key can be left empty when HEDDLE_LLM_PROVIDER is anthropic.
HEDDLE_CLAUDE_API_KEY=
HEDDLE_CLAUDE_BIN=
HEDDLE_CLAUDE_MAX_BUDGET_USD=1

# Older setup. Only read while HEDDLE_LLM_PROVIDER is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
