#!/bin/sh
# The `heddle` command. Runs in the foreground, like the installer leaves it.
set -eu

root="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

HEDDLE_HOME="${HEDDLE_HOME:-$(dirname "$root")}"
# The release cookie is the same in every download, so no distribution at all.
RELEASE_DISTRIBUTION=none
# +fnu: paths may hold accents even when the terminal has no UTF-8 locale.
# +Bi: the VM would die on Ctrl+C and leave the database running. See below.
ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-+fnu +Bi}"
export HEDDLE_HOME RELEASE_DISTRIBUTION ELIXIR_ERL_OPTIONS

case "${1:-start}" in
  start)
    # SIGTERM is what makes the VM shut down in order and stop the database on
    # its way out, so Ctrl+C is turned into that here.
    "$root/bin/heddle" start &
    pid=$!
    trap 'kill -TERM "$pid" 2>/dev/null || true' INT TERM HUP

    status=0
    wait "$pid" || status=$?
    wait "$pid" 2>/dev/null || true
    # Stopped by the trap above: that's a clean exit, not a failure.
    [ "$status" -gt 128 ] && status=0
    exit "$status"
    ;;
  stop)
    exec "$root/pgsql/bin/pg_ctl" -D "$HEDDLE_HOME/data/postgres" -m fast -w stop
    ;;
  version)
    cat "$root/VERSION"
    ;;
  *)
    echo "Usage: heddle [start|stop|version]" >&2
    exit 1
    ;;
esac
